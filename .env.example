# docker compose up --build works without this file or credentials.
# demo: deterministic seeded diagnostics. opencode: real agent through LiteLLM.
TRIAGE_MODE=demo
UI_PORT=7070
API_PORT=7071
TRIAGE_RUN_TIMEOUT_MS=600000

# The provider URL must be reachable from Docker
# and support the OpenAI Responses API (/v1/responses).
LITELLM_BASE_URL=http://host.docker.internal:4000/v1
OPENAI_API_KEY=
# Optional fallback when OPENAI_API_KEY is empty:
LITELLM_API_KEY=
OPENCODE_PROVIDER_ID=litellm
OPENCODE_PROVIDER_NAME=LiteLLM
OPENCODE_MODEL=gpt-6-sol
OPENCODE_SMALL_MODEL=gpt-6-sol
OPENCODE_MODEL_DISPLAY_NAME=GPT-6 Sol
OPENCODE_MODEL_CONTEXT_LIMIT=1050000
OPENCODE_MODEL_INPUT_LIMIT=922000
OPENCODE_MODEL_OUTPUT_LIMIT=16000
OPENCODE_COMPACTION_RESERVED=50000
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=local-dev

# Optional read-only live Azure diagnostics, only with explicit user requests.
TRIAGE_LIVE_AZURE_ENABLED=false
AZURE_LOGIN_WITH_MANAGED_IDENTITY=false
AZURE_CLIENT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=example-observability
# Optional confirmed shared database resource names, comma-separated.
AZURE_STAGING_DATABASE_SERVERS=
AZURE_PRODUCTION_DATABASE_SERVERS=
