# docker compose up --build works without this file or credentials.
# demo: deterministic seeded diagnostics. opencode: direct Microsoft Foundry inference.
TRIAGE_MODE=demo
UI_PORT=7070
API_PORT=7071
TRIAGE_RUN_TIMEOUT_MS=600000

# Foundry resource endpoint, NOT a project endpoint. /openai/v1 is appended.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# This is the deployment NAME in Foundry (which may differ from its model name).
AZURE_OPENAI_DEPLOYMENT=gpt-6-sol
# Leave blank to reuse the primary deployment for lightweight agent tasks.
AZURE_OPENAI_SMALL_DEPLOYMENT=
# api-key: use the key below. azure-cli: use the runtime's Entra-authenticated CLI.
AZURE_OPENAI_AUTH_MODE=api-key
AZURE_OPENAI_API_KEY=
OPENCODE_PROVIDER_ID=foundry
OPENCODE_PROVIDER_NAME=Microsoft Foundry
OPENCODE_MODEL_DISPLAY_NAME=GPT-6 Sol
OPENCODE_MODEL_CONTEXT_LIMIT=1050000
OPENCODE_MODEL_INPUT_LIMIT=922000
OPENCODE_MODEL_OUTPUT_LIMIT=16000
OPENCODE_COMPACTION_RESERVED=50000
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=local-dev

# Optional read-only live Azure diagnostics, only with explicit user requests.
TRIAGE_LIVE_AZURE_ENABLED=false
AZURE_LOGIN_WITH_MANAGED_IDENTITY=false
AZURE_CLIENT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=example-observability
# Optional confirmed shared database resource names, comma-separated.
AZURE_STAGING_DATABASE_SERVERS=
AZURE_PRODUCTION_DATABASE_SERVERS=
